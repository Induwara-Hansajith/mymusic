{
  "name": "my-music",
  "productName": "My Music",
  "desktopName": "mymusic.desktop",
  "version": "1.1.9",
  "description": "My Music - a Spotify-style desktop player powered by YouTube Music",
  "main": "src/main.js",
  "author": "Induwara Hansajith <induwarahansajith10@gmail.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "check": "node -c src/main.js src/preload.js src/lib/store.js src/lib/auth-sync.js src/lib/ytm.js src/lib/downloader.js src/lib/importer.js src/renderer/app.js src/renderer/sonara-engine.js src/renderer/automix-engine.js src/renderer/live-dj-studio.js",
    "smoke": "node test\\smoke.mjs",
    "test:e2e": "node test\\e2e-live.mjs",
    "dist": "npm run check && electron-builder --win --x64",
    "dist:win": "powershell -ExecutionPolicy Bypass -File scripts\\build-signed.ps1",
    "dist:linux": "npm run check && electron-builder --linux tar.gz --x64",
    "dist:linux:all": "npm run check && electron-builder --linux AppImage deb tar.gz --x64",
    "dist:all": "npm run check && powershell -ExecutionPolicy Bypass -File scripts\\build-signed.ps1 && electron-builder --linux tar.gz --x64",
    "dist:publish": "npm run check && electron-builder --win --x64 --publish always"
  },
  "build": {
    "publish": [{
      "provider": "github",
      "owner": "Induwara-Hansajith",
      "repo": "mymusic",
      "releaseType": "draft",
      "publisherName": [
        "My Music (induw)"
      ]
    }],
    "appId": "com.induw.mymusic",
    "productName": "My Music",
    "executableName": "mymusic",
    "copyright": "Copyright © 2026 induw",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "extraResources": [
        {
          "from": "bin/yt-dlp.exe",
          "to": "bin/yt-dlp.exe"
        }
      ],
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "My Music",
      "requestedExecutionLevel": "asInvoker",
      "signtoolOptions": {
        "publisherName": [
          "My Music (induw)"
        ]
      },
      "cscLink": "build/cert.pfx"
    },
    "linux": {
      "maintainer": "Induwara Hansajith <induwarahansajith10@gmail.com>",
      "extraResources": [
        {
          "from": "bin/yt-dlp",
          "to": "bin/yt-dlp"
        }
      ],
      "target": [
        "tar.gz",
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Audio",
      "syncDesktopName": true,
      "synopsis": "My Music - a Spotify-style desktop player powered by YouTube Music",
      "description": "Desktop music player powered by YouTube Music with cross-device cloud sync, lyrics, and studio sound engine.",
      "artifactName": "My.Music.${version}.${ext}"
    },
    "appImage": {
      "artifactName": "My.Music.${version}.${ext}"
    },
    "deb": {
      "artifactName": "My.Music.${version}.${ext}",
      "depends": [
        "libnotify4",
        "libnss3",
        "libxss1",
        "xdg-utils"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "packElevateHelper": false,
      "differentialPackage": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "My Music",
      "uninstallDisplayName": "My Music",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "My.Music.Setup.${version}.${ext}"
    },
    "portable": {
      "artifactName": "My.Music.Portable.${version}.${ext}"
    }
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.5.1",
    "electron-updater": "^6.8.11",
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  }
}
